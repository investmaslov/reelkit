{
  "name": "reelkit",
  "version": "0.1.4",
  "description": "Minimalist React primitives for short-reel preview & timeline editing — a scrub player with sub-second precision, timeline tracks and an editable caption layer.",
  "license": "Apache-2.0",
  "author": {
    "name": "Vladimir Maslov",
    "url": "https://github.com/investmaslov"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/investmaslov/reelkit.git"
  },
  "homepage": "https://github.com/investmaslov/reelkit#readme",
  "bugs": {
    "url": "https://github.com/investmaslov/reelkit/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "react",
    "video",
    "reel",
    "player",
    "scrubber",
    "timeline",
    "captions",
    "editor",
    "preview",
    "9:16"
  ],
  "publishConfig": {
    "access": "public"
  }
}
